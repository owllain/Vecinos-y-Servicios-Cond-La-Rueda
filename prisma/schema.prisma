generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Contador de vistas por anuncio de la guía.
// Se incrementa cada vez que un vecino abre la ficha completa de un
// servicio (ServiceDialog). El catálogo de anuncios vive en el código
// (src/lib/data/services.ts); aquí solo persistimos métricas de uso.
model ServiceView {
  serviceId String   @id // id del anuncio (ServiceListing.id)
  views     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([views])
}
