generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Nota: el directorio "Vecinos y Servicios · Condominio La Rueda" se gestiona
// directamente en el código (src/lib/data/services.ts), por lo que no se
// requieren modelos de datos por ahora. Este esquema queda listo si en el
// futuro se desea persistir anuncios, mensajes o estadísticas de búsqueda.
